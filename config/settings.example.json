{
  "$schema": "./settings.schema.json",
  "version": 3,
  "models": {
    "review": {
      "reviewers": [
        "REPLACE_PROVIDER/REPLACE_MODEL",
        "REPLACE_PROVIDER/REPLACE_MODEL"
      ],
      "rater": ""
    },
    "deep": {
      "reviewers": [],
      "rater": ""
    },
    "quick": {
      "reviewers": [],
      "rater": ""
    }
  },
  "enabled": true,
  "returnReport": "receipt",
  "debug": {
    "enabled": false,
    "directory": "",
    "keepRuns": 20
  },
  "outputLanguage": "en",
  "runTimeoutSeconds": null,
  "shell": "deny",
  "progressNotices": true,
  "deletePrivateSessions": true,
  "terminalPanel": "auto",
  "afterReview": {
    "quick": "preview",
    "review": "preview",
    "deep": "preview"
  },
  "azure": {
    "organization": "",
    "pat": "",
    "patFile": "",
    "concurrency": 6,
    "callTimeoutSeconds": 120,
    "archiveMegabytes": 100,
    "proxy": "",
    "caFile": "",
    "verifyTls": true
  },
  "workflow": {
    "shardFiles": 25,
    "parallelSessions": 8,
    "repairAttempts": 2,
    "stageRetries": 1,
    "stageIdleSeconds": 600
  }
}
